# Ported from Hyprland

# ==========================================
# Variables
# ==========================================
set $mod Mod4

set $terminal alacritty
set $fileManager dolphin
set $menu fuzzel
set $blumenu bzmenu --launcher fuzzel
set $time /home/darshan/scripts/time/time
set $noctalia noctalia msg

# ==========================================
# Autostart
# ==========================================
exec noctalia
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# Autotiling for dwindle layout
exec_always autotiling

# ==========================================
# Output (Monitors)
# ==========================================
output HDMI-A-1 resolution 3840x2160@60Hz position 0,0 scale 2

# ==========================================
# Input Devices
# ==========================================
input type:keyboard {
    xkb_layout us
}

input type:pointer {
    pointer_accel 0
}

input type:touchpad {
    natural_scroll disabled
}

# Specific config for epic-mouse-v1 (Requires exact Sway identifier, leaving disabled until identifier is confirmed)
# input "1234:5678:epic-mouse-v1" pointer_accel -0.5

# ==========================================
# Look and Feel (SwayFX)
# ==========================================
gaps inner 2
gaps outer 6

default_border pixel 2
default_floating_border normal
hide_edge_borders --i3 none
smart_borders off

# Colors
# class                 border  bground text    indicator child_border
client.focused          #c4a7e7 #c4a7e7 #ffffff #c4a7e7   #c4a7e7
client.focused_inactive #595959 #595959 #ffffff #595959   #595959
client.unfocused        #595959 #595959 #ffffff #595959   #595959

# SwayFX specific Eye Candy
corner_radius 15
blur enable
blur_passes 2
blur_radius 2

default_dim_inactive 0.25

# Global window transparency (matches all windows with a title)
for_window [title=".*"] opacity 0.9

# Performance overrides (disable transparency for heavy apps like browsers to prevent lag)
for_window [app_id="firefox"] opacity 1.0
for_window [class="firefox"] opacity 1.0
for_window [class="Firefox"] opacity 1.0



# ==========================================
# Layer Rules (SwayFX)
# ==========================================
layer_effects "noctalia" blur enable; blur_ignore_transparent enable

# ==========================================
# Keybindings
# ==========================================

# Core Binds
bindsym $mod+Shift+c kill
bindsym $mod+Control+c reload
bindsym $mod+Shift+m exec swaymsg exit
bindsym $mod+v floating toggle

# Custom Binds
bindsym $mod+r exec $noctalia panel-toggle launcher

bindsym $mod+t exec $time
bindsym $mod+p split toggle
bindsym $mod+Shift+s exec $noctalia settings-toggle
bindsym $mod+k exec kitty
bindsym $mod+Shift+l exec $noctalia screen-lock

# Move focus
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

# Move/Resize with mouse (floating_modifier acts like bindm for movement/resizing)
floating_modifier $mod normal

# Workspaces (Switch and Wallpaper)
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move window to Workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
